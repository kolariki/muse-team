# ─── LLM providers (completá las que tengas; las que falten se pueden simular con "mock") ───
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
KIMI_API_KEY=
# KIMI_BASE_URL=https://api.moonshot.cn/v1   # solo para keys de China continental
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Modelos por defecto (opcional; en la UI también se eligen de la lista real del proveedor)
# DEFAULT_MODEL_ANTHROPIC=claude-sonnet-5-5
# DEFAULT_MODEL_OPENAI=gpt-5-mini
# DEFAULT_MODEL_DEEPSEEK=deepseek-chat        # o deepseek-reasoner para ver su razonamiento nativo
# DEFAULT_MODEL_GEMINI=gemini-2.5-flash
# OPENAI_REASONING_EFFORT=low
# Precio propio por modelo (USD por 1M tokens in,out):  ARENA_PRICE_GPT_5_MINI=0.25,2

# ─── Langfuse (SDK v4) ─── cloud: https://cloud.langfuse.com  |  local: docker compose (ver README)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_TRACING_ENVIRONMENT=dev

# Bootstrap del Langfuse local (crea org, proyecto, usuario y las keys de arriba al primer arranque)
LANGFUSE_INIT_ORG_ID=tablyteam
LANGFUSE_INIT_ORG_NAME="Tably Team"
LANGFUSE_INIT_PROJECT_ID=tablyteam
LANGFUSE_INIT_PROJECT_NAME="Tably Team"
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=admin@arena.local
LANGFUSE_INIT_USER_NAME="Arena Admin"
LANGFUSE_INIT_USER_PASSWORD=

# Cuentas
# ARENA_ALLOW_SIGNUP=true       # false = solo login (cuentas ya creadas)
# ARENA_TOKEN_TTL_DAYS=30

# Keys por usuario (Configuración): se cifran con este secreto. Si no se define, se genera en backend/data/.secret
# ARENA_SECRET_KEY=
# ARENA_SHARE_SERVER_KEYS=false  # true = los usuarios sin key propia usan las keys de este .env

# Pedir un developer (opcional): links de pago de Stripe por paquete y agenda (Cal.com).
# Los links solo se ofrecen con STRIPE_WEBHOOK_SECRET cargado: es lo que confirma el pago y le manda el ticket al developer
FDE_CHECKOUT_URL_LAUNCH=
FDE_CHECKOUT_URL_SERVICE_SETUP=
FDE_CHECKOUT_URL_INTEGRATION=
FDE_CHECKOUT_URL_REVIEW=
FDE_CHECKOUT_URL_HOURS=
FDE_BOOKING_URL=
# A quién le llega el ticket completo: al confirmarse el pago, o al crearse el pedido si no se puede pagar online. Sin esto va a la casilla de Ivan
FDE_NOTIFY_EMAIL=
# Desde qué dirección salen esos emails y a dónde responde el cliente; sin esto, soporte@tablyteam.com
FDE_SUPPORT_EMAIL=

# Anuncios en video (panel «Anuncios»): Remotion en backend/video (npm install; la imagen de Docker ya lo trae)
# ADS_CHROME=                    # Chrome para renderizar; vacío = el de Remotion (en macOS se usa Google Chrome)
# Publicar en Meta Ads: una app de Meta (developers.facebook.com) con Facebook Login y Marketing API,
# redirect URI <TABLY_CLOUD_URL>/api/meta-ads/callback. Sin estas claves el panel ofrece solo las descargas.
# META_ADS_APP_ID=
# META_ADS_APP_SECRET=
# META_GRAPH_VERSION=v24.0

# AdTier (catálogo de anuncios S/A/B/C): email para pedidos de baja que se muestra en el catálogo (se retira en 48 h)
# ADTIER_TAKEDOWN_EMAIL=
